{
  "name": "markdown-pdf-export",
  "displayName": "Markdown PDF Export",
  "description": "%description%",
  "version": "0.1.4",
  "publisher": "matinfo-tech",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e2128",
    "theme": "dark"
  },
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Matinfo",
    "url": "https://matinfo.tech"
  },
  "homepage": "https://markdown-pdf.matinfo.tech/",
  "repository": {
    "type": "git",
    "url": "https://github.com/matinfo-tech/vscode-markdown-pdf-export"
  },
  "bugs": {
    "url": "https://github.com/matinfo-tech/vscode-markdown-pdf-export/issues"
  },
  "qna": "https://github.com/matinfo-tech/vscode-markdown-pdf-export/issues",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "pdf",
    "export",
    "header",
    "footer",
    "markdown to pdf",
    "markdown pdf",
    "pdf export",
    "pdf preview",
    "convert",
    "print",
    "preview",
    "page numbers",
    "logo",
    "letterhead",
    "report",
    "front matter",
    "mermaid",
    "math",
    "katex"
  ],
  "main": "./dist/extension.cjs",
  "l10n": "./l10n",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%",
      "restrictedConfigurations": [
        "markdownPdfExport.settingsFile"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "markdownPdfExport.export",
        "title": "%command.export.title%",
        "category": "Markdown PDF",
        "icon": "$(file-pdf)"
      },
      {
        "command": "markdownPdfExport.openPreview",
        "title": "%command.openPreview.title%",
        "category": "Markdown PDF",
        "icon": "$(open-preview)"
      },
      {
        "command": "markdownPdfExport.openStudio",
        "title": "%command.openStudio.title%",
        "category": "Markdown PDF",
        "icon": "$(paintcan)"
      },
      {
        "command": "markdownPdfExport.openProjectStudio",
        "title": "%command.openProjectStudio.title%",
        "category": "Markdown PDF"
      },
      {
        "command": "markdownPdfExport.installBrowser",
        "title": "%command.installBrowser.title%",
        "category": "Markdown PDF"
      },
      {
        "command": "markdownPdfExport.showOutput",
        "title": "%command.showOutput.title%",
        "category": "Markdown PDF"
      },
      {
        "command": "markdownPdfExport.openSettingsFile",
        "title": "%command.openSettingsFile.title%",
        "category": "Markdown PDF"
      },
      {
        "command": "markdownPdfExport.openFolderSettingsFile",
        "title": "%command.openFolderSettingsFile.title%",
        "category": "Markdown PDF"
      },
      {
        "command": "markdownPdfExport.runDoctor",
        "title": "%command.runDoctor.title%",
        "category": "Markdown PDF"
      },
      {
        "command": "markdownPdfExport.showMenu",
        "title": "%command.showMenu.title%",
        "category": "Markdown PDF"
      },
      {
        "command": "markdownPdfExport.openDocs",
        "title": "%command.openDocs.title%",
        "category": "Markdown PDF",
        "icon": "$(book)"
      },
      {
        "command": "markdownPdfExport.openWalkthrough",
        "title": "%command.openWalkthrough.title%",
        "category": "Markdown PDF"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "markdownPdfExport.export",
          "when": "editorLangId == markdown"
        }
      ],
      "editor/title": [
        {
          "command": "markdownPdfExport.export",
          "when": "resourceLangId == markdown",
          "group": "navigation@90"
        },
        {
          "command": "markdownPdfExport.openPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation@91"
        },
        {
          "command": "markdownPdfExport.openStudio",
          "when": "resourceLangId == markdown",
          "group": "markdownPdf@1"
        }
      ],
      "editor/context": [
        {
          "command": "markdownPdfExport.export",
          "when": "resourceLangId == markdown",
          "group": "markdownPdf@1"
        },
        {
          "command": "markdownPdfExport.openPreview",
          "when": "resourceLangId == markdown",
          "group": "markdownPdf@2"
        },
        {
          "command": "markdownPdfExport.openStudio",
          "when": "resourceLangId == markdown",
          "group": "markdownPdf@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "markdownPdfExport.export",
          "when": "resourceLangId == markdown",
          "group": "markdownPdf@1"
        },
        {
          "command": "markdownPdfExport.openPreview",
          "when": "resourceLangId == markdown",
          "group": "markdownPdf@2"
        },
        {
          "command": "markdownPdfExport.openStudio",
          "when": "resourceLangId == markdown",
          "group": "markdownPdf@3"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownPdfExport.export",
          "when": "resourceLangId == markdown && !explorerResourceIsFolder",
          "group": "markdownPdf@1"
        },
        {
          "command": "markdownPdfExport.openPreview",
          "when": "resourceLangId == markdown && !explorerResourceIsFolder",
          "group": "markdownPdf@2"
        },
        {
          "command": "markdownPdfExport.openStudio",
          "when": "resourceLangId == markdown && !explorerResourceIsFolder",
          "group": "markdownPdf@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdownPdfExport.export",
        "key": "ctrl+k ctrl+e",
        "mac": "cmd+k cmd+e",
        "when": "editorLangId == markdown && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Markdown PDF Export",
      "properties": {
        "markdownPdfExport.settingsFile": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.settingsFile.markdownDescription%"
        },
        "markdownPdfExport.browser": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.browser.markdownDescription%"
        },
        "markdownPdfExport.preview.refresh": {
          "type": "string",
          "enum": [
            "onType",
            "onSave"
          ],
          "enumDescriptions": [
            "%config.preview.refresh.onType%",
            "%config.preview.refresh.onSave%"
          ],
          "default": "onType",
          "scope": "window",
          "description": "%config.preview.refresh.description%"
        },
        "markdownPdfExport.debug": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "%config.debug.description%"
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          ".markdown-pdf.json",
          "**/markdown-pdf-export/settings.json"
        ],
        "url": "./node_modules/markdown-pdf-export/schema/settings.schema.json"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "markdownPdfExport.mcp",
        "label": "Markdown PDF Export"
      }
    ],
    "walkthroughs": [
      {
        "id": "markdownPdfExport.start",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "preview",
            "title": "%walkthrough.preview.title%",
            "description": "%walkthrough.preview.description%",
            "media": {
              "markdown": "media/walkthrough/preview.md"
            },
            "completionEvents": [
              "onCommand:markdownPdfExport.openPreview"
            ]
          },
          {
            "id": "design",
            "title": "%walkthrough.design.title%",
            "description": "%walkthrough.design.description%",
            "media": {
              "markdown": "media/walkthrough/design.md"
            },
            "completionEvents": [
              "onCommand:markdownPdfExport.openStudio"
            ]
          },
          {
            "id": "document",
            "title": "%walkthrough.document.title%",
            "description": "%walkthrough.document.description%",
            "media": {
              "markdown": "media/walkthrough/document.md"
            }
          },
          {
            "id": "export",
            "title": "%walkthrough.export.title%",
            "description": "%walkthrough.export.description%",
            "media": {
              "markdown": "media/walkthrough/export.md"
            },
            "completionEvents": [
              "onCommand:markdownPdfExport.export"
            ]
          },
          {
            "id": "setup",
            "title": "%walkthrough.setup.title%",
            "description": "%walkthrough.setup.description%",
            "media": {
              "markdown": "media/walkthrough/setup.md"
            },
            "completionEvents": [
              "onCommand:markdownPdfExport.runDoctor"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package",
    "smoke:vsix": "npm run vscode:prepublish && node scripts/smoke-vsix.mjs",
    "test:integration": "npm run build && vscode-test"
  },
  "dependencies": {
    "markdown-pdf-export": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/vscode": "1.101.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "ovsx": "1.4.0",
    "pdfjs-dist": "6.5.438",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}

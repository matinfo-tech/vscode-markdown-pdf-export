{
  "name": "markdown-pdf-export",
  "displayName": "Markdown PDF Export",
  "description": "The real PDF beside your Markdown, as you type. Design the header, footer, page numbers and logo by clicking, then export.",
  "version": "0.1.1",
  "publisher": "matinfo-tech",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e2128",
    "theme": "dark"
  },
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Matinfo",
    "url": "https://matinfo.tech"
  },
  "homepage": "https://markdown-pdf.matinfo.tech/",
  "repository": {
    "type": "git",
    "url": "https://github.com/matinfo-tech/vscode-markdown-pdf-export"
  },
  "bugs": {
    "url": "https://github.com/matinfo-tech/vscode-markdown-pdf-export/issues"
  },
  "qna": "https://github.com/matinfo-tech/vscode-markdown-pdf-export/issues",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "pdf",
    "export",
    "header",
    "footer",
    "markdown to pdf",
    "markdown pdf",
    "pdf export",
    "pdf preview",
    "convert",
    "print",
    "preview",
    "page numbers",
    "logo",
    "letterhead",
    "report",
    "front matter",
    "mermaid",
    "math",
    "katex"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Exporting reads the Markdown file and its images from disk."
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, project settings files (.markdown-pdf.json) are ignored and raw HTML is always made safe.",
      "restrictedConfigurations": [
        "markdownPdfExport.settingsFile"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "markdownPdfExport.export",
        "title": "Export to PDF",
        "category": "Markdown PDF",
        "icon": "$(file-pdf)"
      },
      {
        "command": "markdownPdfExport.openPreview",
        "title": "Open PDF Preview to the Side",
        "category": "Markdown PDF",
        "icon": "$(open-preview)"
      },
      {
        "command": "markdownPdfExport.openStudio",
        "title": "Design Pages",
        "category": "Markdown PDF",
        "icon": "$(paintcan)"
      },
      {
        "command": "markdownPdfExport.openProjectStudio",
        "title": "Design Pages for This Folder Only",
        "category": "Markdown PDF"
      },
      {
        "command": "markdownPdfExport.installBrowser",
        "title": "Download PDF Browser",
        "category": "Markdown PDF"
      },
      {
        "command": "markdownPdfExport.showOutput",
        "title": "Show Output",
        "category": "Markdown PDF"
      },
      {
        "command": "markdownPdfExport.openSettingsFile",
        "title": "Open Settings File",
        "category": "Markdown PDF"
      },
      {
        "command": "markdownPdfExport.openFolderSettingsFile",
        "title": "Open This Folder's Settings File",
        "category": "Markdown PDF"
      },
      {
        "command": "markdownPdfExport.runDoctor",
        "title": "Check Setup",
        "category": "Markdown PDF"
      },
      {
        "command": "markdownPdfExport.showMenu",
        "title": "Show Menu",
        "category": "Markdown PDF"
      },
      {
        "command": "markdownPdfExport.openDocs",
        "title": "Open Documentation",
        "category": "Markdown PDF",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "markdownPdfExport.export",
          "when": "editorLangId == markdown"
        }
      ],
      "editor/title": [
        {
          "command": "markdownPdfExport.export",
          "when": "resourceLangId == markdown",
          "group": "navigation@90"
        },
        {
          "command": "markdownPdfExport.openPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation@91"
        },
        {
          "command": "markdownPdfExport.openStudio",
          "when": "resourceLangId == markdown",
          "group": "markdownPdf@1"
        }
      ],
      "editor/context": [
        {
          "command": "markdownPdfExport.export",
          "when": "resourceLangId == markdown",
          "group": "markdownPdf@1"
        },
        {
          "command": "markdownPdfExport.openPreview",
          "when": "resourceLangId == markdown",
          "group": "markdownPdf@2"
        },
        {
          "command": "markdownPdfExport.openStudio",
          "when": "resourceLangId == markdown",
          "group": "markdownPdf@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "markdownPdfExport.export",
          "when": "resourceLangId == markdown",
          "group": "markdownPdf@1"
        },
        {
          "command": "markdownPdfExport.openPreview",
          "when": "resourceLangId == markdown",
          "group": "markdownPdf@2"
        },
        {
          "command": "markdownPdfExport.openStudio",
          "when": "resourceLangId == markdown",
          "group": "markdownPdf@3"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownPdfExport.export",
          "when": "resourceLangId == markdown && !explorerResourceIsFolder",
          "group": "markdownPdf@1"
        },
        {
          "command": "markdownPdfExport.openPreview",
          "when": "resourceLangId == markdown && !explorerResourceIsFolder",
          "group": "markdownPdf@2"
        },
        {
          "command": "markdownPdfExport.openStudio",
          "when": "resourceLangId == markdown && !explorerResourceIsFolder",
          "group": "markdownPdf@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdownPdfExport.export",
        "key": "ctrl+k ctrl+e",
        "mac": "cmd+k cmd+e",
        "when": "editorLangId == markdown && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Markdown PDF Export",
      "properties": {
        "markdownPdfExport.settingsFile": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path of a settings file to use instead of your own (`~/.config/markdown-pdf-export/settings.json`, or `%APPDATA%\\markdown-pdf-export\\settings.json` on Windows). Leave empty in most cases: page design lives in that one file, shared with the command line and other editors."
        },
        "markdownPdfExport.browser": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Browser that draws the PDF: `chrome`, `msedge`, `chromium`, or the full path of a browser. Leave empty to use Chrome or Edge when installed."
        },
        "markdownPdfExport.preview.refresh": {
          "type": "string",
          "enum": [
            "onType",
            "onSave"
          ],
          "enumDescriptions": [
            "Draw the PDF again shortly after you stop typing.",
            "Draw the PDF again when the file is saved."
          ],
          "default": "onType",
          "scope": "window",
          "description": "When the PDF preview follows your changes."
        },
        "markdownPdfExport.debug": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Write a debug log in the temporary folder."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          ".markdown-pdf.json",
          "**/markdown-pdf-export/settings.json"
        ],
        "url": "./node_modules/markdown-pdf-export/schema/settings.schema.json"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "markdownPdfExport.mcp",
        "label": "Markdown PDF Export"
      }
    ],
    "walkthroughs": [
      {
        "id": "markdownPdfExport.start",
        "title": "Get started with Markdown PDF Export",
        "description": "See the real PDF beside your Markdown, design its header and footer, and export.",
        "steps": [
          {
            "id": "preview",
            "title": "See the real PDF while you write",
            "description": "Open a Markdown file, then open the preview beside it.\n[Open the PDF preview](command:markdownPdfExport.openPreview)",
            "media": {
              "markdown": "media/walkthrough/preview.md"
            },
            "completionEvents": [
              "onCommand:markdownPdfExport.openPreview"
            ]
          },
          {
            "id": "design",
            "title": "Design your header and footer",
            "description": "Page style, fonts, header, footer and logo, shown on the PDF as you choose.\n[Design pages](command:markdownPdfExport.openStudio)",
            "media": {
              "markdown": "media/walkthrough/design.md"
            },
            "completionEvents": [
              "onCommand:markdownPdfExport.openStudio"
            ]
          },
          {
            "id": "document",
            "title": "One document, its own design",
            "description": "A pdf: block at the top of a file changes only that document, with suggestions as you type.\n[Read more](command:markdownPdfExport.openDocs?%5B%22per-document%22%5D)",
            "media": {
              "markdown": "media/walkthrough/document.md"
            }
          },
          {
            "id": "export",
            "title": "Export",
            "description": "One key press writes the PDF next to the Markdown.\n[Export this file](command:markdownPdfExport.export)",
            "media": {
              "markdown": "media/walkthrough/export.md"
            },
            "completionEvents": [
              "onCommand:markdownPdfExport.export"
            ]
          },
          {
            "id": "setup",
            "title": "Something not working?",
            "description": "Check the browser and the settings files in use.\n[Check setup](command:markdownPdfExport.runDoctor)",
            "media": {
              "markdown": "media/walkthrough/setup.md"
            },
            "completionEvents": [
              "onCommand:markdownPdfExport.runDoctor"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package",
    "smoke:vsix": "npm run vscode:prepublish && node scripts/smoke-vsix.mjs",
    "test:integration": "npm run build && vscode-test"
  },
  "dependencies": {
    "markdown-pdf-export": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/vscode": "1.101.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "ovsx": "1.4.0",
    "pdfjs-dist": "6.5.438",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
